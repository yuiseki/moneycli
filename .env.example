# Default provider name
# MONEYCLI_PROVIDER=money_forward

# Optional cache directory path
# MONEYCLI_CACHE_DIR=./cache

# Optional additional provider modules (comma-separated paths)
# MONEYCLI_PROVIDER_MODULES=./providers/custom.js

# Money Forward cookie file
# MONEYFORWARD_COOKIE_PATH=./.cookies/moneyforward.com.cookie.json
